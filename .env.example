# Скопируйте этот файл в .env и впишите ключи. Файл .env не попадает в git.
# Ключи можно вписать и прямо на сайте — нажмите на источник вверху страницы.
# Какие ID в сетях относятся к одной игре — в apps.json.

# Яндекс РСЯ: OAuth-токен для API статистики
YANDEX_OAUTH_TOKEN=

# VK Рекламная сеть: токен Reporting API
VK_TOKEN=

# Unity Ads: ключ Monetization Stats API и ID организации
UNITY_API_KEY=
UNITY_ORG_ID=

# Firebase / Google Analytics 4: ID ресурса и ключ сервисного аккаунта (JSON-файл) — для раздела «Игроки» Bottle Sort
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=./secrets/ga-service-account.json
# На Vercel файла нет: вставьте содержимое JSON-ключа целиком (или в base64) в эту переменную.
GA_SERVICE_ACCOUNT_JSON=

# Вход на сайт. На Vercel обязателен — без этих двух переменных сайт не отдаёт данные.
# На своём компьютере можно не задавать: сайт открывается без входа.
DASHBOARD_EMAIL=
DASHBOARD_PASSWORD=
